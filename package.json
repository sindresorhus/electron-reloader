{
	"name": "electron-reloader",
	"version": "1.2.3",
	"description": "Simple auto-reloading for Electron apps during development",
	"license": "MIT",
	"repository": "sindresorhus/electron-reloader",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "electron test/main/index.mjs",
		"test": "xo && tsd"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"electron",
		"reload",
		"reloader",
		"livereload",
		"auto-reload",
		"live-reload",
		"refresh",
		"restart",
		"watch",
		"watcher",
		"watching",
		"monitor",
		"hot",
		"files",
		"fs",
		"dev",
		"development"
	],
	"dependencies": {
		"chalk": "^6.0.0",
		"chokidar": "^5.0.0",
		"date-time": "^4.0.0",
		"electron-is-dev": "^3.0.1",
		"find-up": "^8.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"electron": "^44.4.3",
		"tsd": "^0.33.0",
		"xo": "^5.0.1"
	},
	"tsd": {
		"compilerOptions": {
			"module": "esnext"
		}
	},
	"xo": [
		{
			"ignores": [
				"test/index.html"
			]
		}
	]
}
